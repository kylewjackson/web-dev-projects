---
layout: layouts/base.liquid
permalink: /index.html
pageId: index
headerPartial: partials/home-hero.liquid
title: Kyle Jackson - Front End Developer Portfolio | kylejackson.dev
socialTitle: Kyle Jackson - Front End Developer Portfolio
description: Hi, I'm Kyle Jackson, a Front End Web Developer based in the Dallas-Fort Worth area. I'm all about creative, responsive, and practical website solutions.
canonical: https://www.kylejackson.dev
---
<section id="intro" class="content">
  <figure>
    <img src="/images/icons/self-portrait-icon.svg" alt="" id="self-portrait-icon" class="icon" data-reveal>
  </figure>
  <h2 id="intro-heading" class="content-heading" data-reveal>Hey, I'm Kyle.</h2>
  <figure id="intro-icons" class="container" data-reveal>
    <img src="/images/icons/digital-art-icon.svg" alt="" id="digital-art-icon" class="icon">
    <img src="/images/icons/popcorn-icon.svg" alt="" id="popcorn-icon" class="icon">
    <img src="/images/icons/coding-icon.svg" alt="" id="coding-icon" class="icon">
  </figure>
  <p class="intro-paragraph" data-reveal>
    I’m a digital art hobbyist, movie lover, and your next front-end web
    developer! Being <strong class="accent-pink">self-taught</strong>,
    I’ve got the <em class="accent-blue">motivation</em>,
    <em class="accent-blue">creativity</em>, and
    <em class="accent-blue">fresh perspective</em> needed to help realize
    your vision for your website.
  </p>
  <p class="employ-paragraph" data-reveal>
    I’m based in the
    <strong class="accent-pink">Dallas-Fort Worth</strong> area, and am
    currently employed at
    <strong class="accent-blue">Sally Beauty Holdings</strong> as a
    <em class="accent-pink">Sr. Front End Developer</em>. I'm also open to
    freelance work.
  </p>
</section>

<section id="tools" class="content">
  <h2 id="index-tools-heading" class="content-heading" data-reveal>Skills</h2>
  <img src="/images/icons/tools-icon.svg" alt="" id="tools-icon" class="icon" data-reveal>
  {% for group in homeSkills %}
    <h3 id="{{ group.id }}-sub-heading" class="sub-heading" data-reveal>{{ group.heading | escape }}</h3>
    <ul id="{{ group.id }}-container" class="container" role="list">
      {% for skill in group.tiles %}
        <li id="{{ skill.abbr }}-box" class="tool-box" data-reveal>
          <b id="{{ skill.abbr }}-symbol" class="tool-symbol" aria-hidden="true">{{ skill.symbol | escape }}</b>
          <span id="{{ skill.abbr }}-name" class="tool-name">{{ skill.name | escape }}</span>
        </li>
      {% endfor %}
    </ul>
  {% endfor %}
</section>

<section id="projects" class="content">
  <h2 id="projects-heading" class="content-heading" data-reveal>Recent Projects</h2>
  <img src="/images/icons/gear-icon.svg" alt="" id="gear-icon" class="icon" data-reveal>
  {% assign featured = projects | where: "featuredOnHome", true %}
  {% for project in featured %}
    {% render "partials/project-card.liquid", project: project, cardHeading: "h3" %}
  {% endfor %}
</section>
<script type="module" src="/scripts/reveal.js"></script>
